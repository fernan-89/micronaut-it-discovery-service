{
  "info": {
    "_postman_id": "b2c4d6e8-5a7b-4c9d-8e1f-2a4b6c8d0e1f",
    "name": "IT Discovery Service - Staging & Promotion Suite",
    "description": "Enterprise-grade E2E Postman Suite for the IT Discovery Service Domain (BIAN-aligned, ADR-001/005/013/019/030/031/032). Covers the DiscoveredItem lifecycle under /it-discovery/v1 (initiate, retrieve, review/claim, review/update, control/ignore, control/promote), idempotent re-ingestion (RESEEN), the real cross-service promotion into it-asset-registry-service, mandatory X-Tenant-Id/X-Executor auditing, RFC 7807 error_code assertions (400/404/409) and W3C traceparent correlation. Requires an organisationId environment variable populated from the Party Reference Data Directory Service Domain, and a live it-asset-registry-service for the promotion step.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "39879181"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Automatically generate standard W3C traceparent (ADR-010) and X-Trace-Id",
          "function generateHex(len) {",
          "    let result = '';",
          "    const chars = '0123456789abcdef';",
          "    for (let i = 0; i < len; i++) {",
          "        result += chars.charAt(Math.floor(Math.random() * chars.length));",
          "    }",
          "    return result;",
          "}",
          "const traceId = generateHex(32);",
          "const spanId = generateHex(16);",
          "const traceparent = `00-${traceId}-${spanId}-01`;",
          "pm.request.headers.upsert({ key: 'traceparent', value: traceparent });",
          "pm.request.headers.upsert({ key: 'X-Trace-Id', value: traceId });",
          "pm.environment.set('currentTraceId', traceId);"
        ]
      }
    }
  ],
